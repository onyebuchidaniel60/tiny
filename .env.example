# Tiny — safe environment template
#
# Copy this file to `.env` for local development. NEVER commit `.env`.
# This file contains placeholders only. Do not put real keys, tokens,
# service-account JSON, phone numbers or pupil/guardian data here.
#
# Secret values belong in:
#   - GitHub Actions repository/environment secrets (for CI and App Distribution)
#   - Google Secret Manager / Firebase Functions secrets (for deployed functions)
#   - ignored local files (for local emulator/testing only)
#
# See docs/CREDENTIALS_AND_CONFIGURATION_REGISTER.md for ownership and timing.

# ---------------------------------------------------------------------------
# Firebase / Google Cloud project (public configuration unless marked secret)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=tiny-b9f29
GCLOUD_PROJECT_ID=tiny-b9f29
FIREBASE_ANDROID_APP_ID=__FIREBASE_ANDROID_APP_ID__
FIREBASE_REGION=africa-south1
FIRESTORE_DATABASE_ID=(default)
APP_ENV=development

# Firebase client configuration path. This is public client configuration,
# not a server credential. In CI it is materialized from a GitHub secret.
GOOGLE_SERVICES_JSON_PATH=__PATH_TO_GOOGLE_SERVICES_JSON__
GOOGLE_SERVICES_JSON_BASE64=__SET_IN_GITHUB_ACTIONS_SECRET__

# CI identity for App Distribution. Prefer Workload Identity Federation.
GCP_WORKLOAD_IDENTITY_PROVIDER=__SET_IN_GITHUB_ACTIONS_VARIABLE__
GCP_SERVICE_ACCOUNT_EMAIL=__SET_IN_GITHUB_ACTIONS_VARIABLE__
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=__PATH_OUTSIDE_REPOSITORY__
FIREBASE_SERVICE_ACCOUNT_JSON=__SET_IN_GITHUB_ACTIONS_SECRET_ONLY_IF_NEEDED__
FIREBASE_TOKEN=__SET_IN_GITHUB_ACTIONS_SECRET_ONLY_IF_WIF_UNAVAILABLE__

# Local debug App Check token. Secret; local only; never commit or ship.
APP_CHECK_DEBUG_TOKEN=__SET_LOCALLY_NEVER_COMMIT__
PLAY_INTEGRITY_SHA256=__PUBLIC_SIGNING_CERT_FINGERPRINT__

# Firebase AI Logic / Gemini Developer API free tier.
AI_PROVIDER=firebase-ai-logic
CLOUD_MODEL_NAME=gemini-3.5-flash-lite
AI_DAILY_CLOUD_LIMIT_PER_USER=__TBD_CONSERVATIVE_LIMIT__
AI_MAX_OUTPUT_TOKENS=256

# ---------------------------------------------------------------------------
# Android build and release signing
# ---------------------------------------------------------------------------
ANDROID_APPLICATION_ID=ng.tiny.education
ANDROID_MIN_SDK=26
ANDROID_COMPILE_SDK=__PIN_CURRENT_STABLE_SDK__
ANDROID_TARGET_SDK=__PIN_CURRENT_STABLE_SDK__
VERSION_CODE=1
VERSION_NAME=0.1.0

# Release signing: set only in GitHub Actions secrets or an ignored local file.
ANDROID_KEYSTORE_PATH=__PATH_OUTSIDE_REPOSITORY__
ANDROID_KEYSTORE_BASE64=__SET_IN_GITHUB_ACTIONS_SECRET__
ANDROID_KEYSTORE_PASSWORD=__SET_IN_GITHUB_ACTIONS_SECRET__
ANDROID_KEY_ALIAS=__SET_IN_GITHUB_ACTIONS_SECRET__
ANDROID_KEY_PASSWORD=__SET_IN_GITHUB_ACTIONS_SECRET__

# ---------------------------------------------------------------------------
# Functions / messaging / AI limits
# ---------------------------------------------------------------------------
# Development is mock-only. Do not change to sandbox or production without
# explicit operator authorization and approved budget.
SMS_MODE=mock
ESMS_API_KEY=__SET_IN_SECRET_MANAGER_WHEN_AUTHORIZED__
ESMS_WEBHOOK_SECRET=__SET_IN_SECRET_MANAGER_WHEN_AUTHORIZED__
ESMS_SERVICE_ID=__SET_WHEN_AUTHORIZED__
ESMS_SENDER_KEYWORD=TINY
ESMS_BASE_URL=__SET_WHEN_AUTHORIZED__
SMS_MONTHLY_BUDGET_MINOR=0
SMS_DAILY_SEGMENT_LIMIT=0
SMS_ALLOWED_RECIPIENTS=

INVITATION_TTL_DAYS=7
SYNC_BATCH_LIMIT=20
DIGEST_TIMEZONE=Africa/Lagos
DIGEST_CRON=0 15 * * 5

FUNCTIONS_MIN_INSTANCES=0
FUNCTIONS_MAX_INSTANCES=__TBD_CONSERVATIVE_LIMIT__
FUNCTIONS_CONCURRENCY=__TBD_CONSERVATIVE_LIMIT__
FUNCTIONS_MEMORY=256MiB
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Firebase App Distribution / judge access
# ---------------------------------------------------------------------------
# Group aliases only. Do not put tester email addresses in this file.
FIREBASE_APP_DISTRIBUTION_GROUPS=internal-testers,judges
