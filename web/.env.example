# Firebase Web app (public client configuration; not a server secret)
VITE_FIREBASE_API_KEY=__FIREBASE_WEB_API_KEY__
VITE_FIREBASE_AUTH_DOMAIN=tiny-b9f29.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tiny-b9f29
VITE_FIREBASE_STORAGE_BUCKET=tiny-b9f29.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1072757481941
VITE_FIREBASE_APP_ID=__FIREBASE_WEB_APP_ID__

# Dedicated web App Check debug token for the synthetic preview.
# Secret; set in the build environment or GitHub Actions. Never commit.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=__WEB_APP_CHECK_DEBUG_TOKEN__

# Optional reCAPTCHA Enterprise site key if a real App Check provider is used.
VITE_RECAPTCHA_SITE_KEY=

# Synthetic Firebase Auth demo account for the browser preview.
VITE_DEMO_EMAIL=judge@tiny-demo.example
VITE_DEMO_PASSWORD=__SYNTHETIC_DEMO_PASSWORD__

# Set true only when running the local Firebase Emulator Suite.
VITE_FUNCTIONS_EMULATOR=false
